  "multipart": [
    { "when": { "formed": false }, "apply": { "model": "dopasrandomutilities:block/solar_panel_tier3" } },
    { "when": { "formed": true }, "apply": { "model": "dopasrandomutilities:block/solar_panel_tier3_formed" } },
    { "when": { "formed": true, "north": false }, "apply": { "model": "dopasrandomutilities:block/solar_panel_tier3_formed_rim" } },
